<?xml version="1.0" encoding="UTF-8"?>

<?import java.lang.String?>
<?import javafx.collections.FXCollections?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<AnchorPane prefHeight="600.0" prefWidth="800.0"
            style="-fx-background-color: #FAF9F3;"
            stylesheets="@../css/main.css"
            xmlns="http://javafx.com/javafx/17.0.12"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.github.luantenorio.projetocopatp1.users.CreateUserController">

    <children>

        <VBox layoutX="50.0"
              layoutY="50.0"
              spacing="30.0"
              AnchorPane.leftAnchor="50.0"
              AnchorPane.rightAnchor="50.0"
              AnchorPane.topAnchor="50.0">

            <children>

                <!-- NOME -->
                <VBox spacing="10.0">
                    <children>
                        <StackPane alignment="CENTER"
                                   maxWidth="150.0"
                                   prefHeight="45.0"
                                   styleClass="yellow-label">
                            <children>
                                <Label text="NOME" styleClass="blue-text"/>
                            </children>
                        </StackPane>

                        <TextField fx:id="txtName"
                                   promptText="João da Silva..."
                                   styleClass="input"/>
                    </children>
                </VBox>

                <!-- FUNÇÃO / STATUS -->
                <HBox spacing="40.0">

                    <children>

                        <VBox spacing="10.0" HBox.hgrow="ALWAYS">
                            <children>

                                <StackPane alignment="CENTER"
                                           maxWidth="170.0"
                                           prefHeight="45.0"
                                           styleClass="yellow-label">
                                    <children>
                                        <Label text="FUNÇÃO"
                                               styleClass="blue-text"/>
                                    </children>
                                </StackPane>

                                <ComboBox fx:id="txtRole"
                                          maxWidth="Infinity"
                                          promptText="Selecione uma função"
                                          styleClass="input">

                                    <items>
                                        <FXCollections fx:factory="observableArrayList">
                                            <String fx:value="Administrador"/>
                                            <String fx:value="Operador"/>
                                            <String fx:value="Árbitro"/>
                                        </FXCollections>
                                    </items>

                                </ComboBox>

                            </children>
                        </VBox>

                        <VBox spacing="10.0" HBox.hgrow="ALWAYS">
                            <children>

                                <StackPane alignment="CENTER"
                                           maxWidth="170.0"
                                           prefHeight="45.0"
                                           styleClass="yellow-label">
                                    <children>
                                        <Label text="STATUS"
                                               styleClass="blue-text"/>
                                    </children>
                                </StackPane>

                                <ComboBox fx:id="txtStatus"
                                          maxWidth="Infinity"
                                          promptText="Ativo..."
                                          styleClass="input">

                                    <items>
                                        <FXCollections fx:factory="observableArrayList">
                                            <String fx:value="Ativo"/>
                                            <String fx:value="Inativo"/>
                                            <String fx:value="Bloqueado"/>
                                        </FXCollections>
                                    </items>

                                </ComboBox>

                            </children>
                        </VBox>

                    </children>

                </HBox>

                <!-- PAÍS / SENHA -->
                <HBox spacing="40.0">

                    <children>

                        <VBox spacing="10.0" HBox.hgrow="ALWAYS">
                            <children>

                                <StackPane alignment="CENTER"
                                           maxWidth="170.0"
                                           prefHeight="45.0"
                                           styleClass="yellow-label">
                                    <children>
                                        <Label text="PAÍS"
                                               styleClass="blue-text"/>
                                    </children>
                                </StackPane>

                                <TextField fx:id="txtCountry"
                                           promptText="Brasil..."
                                           styleClass="input"/>

                            </children>
                        </VBox>

                        <VBox spacing="10.0" HBox.hgrow="ALWAYS">
                            <children>

                                <StackPane alignment="CENTER"
                                           maxWidth="170.0"
                                           prefHeight="45.0"
                                           styleClass="yellow-label">
                                    <children>
                                        <Label text="SENHA"
                                               styleClass="blue-text"/>
                                    </children>
                                </StackPane>

                                <PasswordField fx:id="txtPassword"
                                               promptText="Defina uma senha"
                                               styleClass="input"/>

                            </children>
                        </VBox>

                    </children>

                </HBox>

            </children>

        </VBox>

        <Button fx:id="buttonOperate"
                onMouseClicked="#operate"
                mnemonicParsing="false"
                styleClass="button"
                text="REGISTRAR"
                AnchorPane.bottomAnchor="40.0"
                AnchorPane.rightAnchor="50.0"/>

    </children>

</AnchorPane>