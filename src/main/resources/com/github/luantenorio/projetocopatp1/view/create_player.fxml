<?xml version="1.0" encoding="UTF-8"?>

<?import java.lang.String?>
<?import javafx.collections.FXCollections?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<AnchorPane prefHeight="600.0" prefWidth="800.0" style="-fx-background-color: #FAF9F3;" stylesheets="@../css/main.css" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.github.luantenorio.projetocopatp1.player.CreatePlayerController">
    <children>
        <VBox layoutX="50.0" layoutY="50.0" spacing="30.0" AnchorPane.leftAnchor="50.0" AnchorPane.rightAnchor="50.0" AnchorPane.topAnchor="50.0">
            <children>

                <VBox spacing="10.0">
                    <children>
                        <StackPane alignment="CENTER" maxWidth="150.0" prefHeight="45.0" styleClass="yellow-label">
                            <children>
                                <Label styleClass="blue-text" text="NOME" />
                            </children>
                        </StackPane>
                        <TextField fx:id="txtName" promptText="Neymar Jr..." styleClass="input" />
                    </children>
                </VBox>

                <HBox spacing="40.0">
                    <children>
                        <VBox spacing="10.0" HBox.hgrow="ALWAYS">
                            <children>
                                <StackPane alignment="CENTER" maxWidth="200.0" prefHeight="45.0" styleClass="yellow-label">
                                    <children>
                                        <Label styleClass="blue-text" text="POSIÇÃO" />
                                    </children>
                                </StackPane>
                                <ComboBox fx:id="txtPosition" maxWidth="Infinity" promptText="Selecione a posição" styleClass="input">
                                    <items>
                                        <FXCollections fx:factory="observableArrayList">
                                            <String fx:value="GOL" />
                                            <String fx:value="DEF" />
                                            <String fx:value="MEI" />
                                            <String fx:value="ATA" />
                                        </FXCollections>
                                    </items>
                                </ComboBox>
                            </children>
                        </VBox>

                        <VBox spacing="10.0" HBox.hgrow="ALWAYS">
                            <children>
                                <StackPane alignment="CENTER" maxWidth="200.0" prefHeight="45.0" styleClass="yellow-label">
                                    <children>
                                        <Label styleClass="blue-text" text="STATUS" />
                                    </children>
                                </StackPane>
                                <ComboBox fx:id="txtStatus" maxWidth="Infinity" promptText="Selecione o status" styleClass="input">
                                    <items>
                                        <FXCollections fx:factory="observableArrayList">
                                            <String fx:value="Ativo" />
                                            <String fx:value="Lesionado" />
                                            <String fx:value="Suspenso" />
                                        </FXCollections>
                                    </items>
                                </ComboBox>
                            </children>
                        </VBox>
                    </children>
                </HBox>

                <HBox spacing="40.0">
                    <children>
                        <VBox spacing="10.0" HBox.hgrow="ALWAYS">
                            <children>
                                <StackPane alignment="CENTER" maxWidth="200.0" prefHeight="45.0" styleClass="yellow-label">
                                    <children>
                                        <Label styleClass="blue-text" text="NÚMERO" />
                                    </children>
                                </StackPane>
                                <TextField fx:id="txtNumber" promptText="10..." styleClass="input" />
                            </children>
                        </VBox>

                        <VBox spacing="10.0" HBox.hgrow="ALWAYS">
                            <children>
                                <StackPane alignment="CENTER" maxWidth="200.0" prefHeight="45.0" styleClass="yellow-label">
                                    <children>
                                        <Label styleClass="blue-text" text="IDADE" />
                                    </children>
                                </StackPane>
                                <TextField fx:id="txtAge" promptText="24..." styleClass="input" />
                            </children>
                        </VBox>
                    </children>
                </HBox>
            </children>
        </VBox>

        <Button fx:id="buttonOperate" onMouseClicked="#operate" layoutX="634.0" layoutY="530.0" mnemonicParsing="false" styleClass="button" text="Registrar" AnchorPane.bottomAnchor="40.0" AnchorPane.rightAnchor="50.0" />
        <Button fx:id="buttonDelete" onMouseClicked="#delete" layoutX="634.0" layoutY="530.0" mnemonicParsing="false" styleClass="button-red" text="Deletar" AnchorPane.bottomAnchor="40.0" AnchorPane.leftAnchor="50.0" />
    </children>
</AnchorPane>
